<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Arman"/>
        <attribute name="authors" value="LENOVO"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-16 06:09:00 PM"/>
        <attribute name="created" value="TEVOT1ZPO0xBUFRPUC1UUkJNS0M3ODsyMDI2LTA5LTE2OzAxOjAyOjI5IFBNOzI4MjI="/>
        <attribute name="edited" value="TEVOT1ZPO0xBUFRPUC1UUkJNS0M3ODsyMDI2LTA5LTE2OzAyOjIxOjAzIFBNOzE7MjkyNA=="/>
        <attribute name="edited" value="VmljdHVzO0RFU0tUT1AtMks3Vk9FVjsyMDI2LTA5LTE2OzA2OjA5OjAwIFBNOzE7MzExNA=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="UsiaPembeli, JumlahTiket" type="Integer" array="False" size=""/>
            <declare name="KategoriFilm" type="String" array="False" size=""/>
            <declare name="HargaDasar, Diskon, HargaSetelahDiskon, Total" type="Real" array="False" size=""/>
            <assign variable="HargaDasar" expression="60000"/>
            <output expression="&quot;Selamat Datang di Cinemax&quot;" newline="True"/>
            <output expression="&quot;Mau nonton film apa?&quot;" newline="True"/>
            <input variable="KategoriFilm"/>
            <output expression="&quot;Berapa usia anda?&quot;" newline="True"/>
            <input variable="UsiaPembeli"/>
            <output expression="&quot;Anda ingin beli berapa tiket?&quot;" newline="True"/>
            <input variable="JumlahTiket"/>
            <if expression="KategoriFilm=&quot;Dewasa&quot; and UsiaPembeli&lt;17">
                <then>
                    <output expression="&quot;Maaf anda belum boleh menonton film tersebut,Usia anda belum mencukupi&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="UsiaPembeli&lt;12">
                        <then>
                            <assign variable="Diskon" expression="0.20"/>
                            <assign variable="HargaSetelahDiskon" expression="HargaDasar - (HargaDasar * Diskon)"/>
                            <assign variable="Total" expression="HargaSetelahDiskon * JumlahTiket"/>
                            <output expression="&quot;Karena anda masih anak-anak anda mendapat diskon sebesar 20%&quot;" newline="True"/>
                        </then>
                        <else>
                            <if expression="UsiaPembeli&gt;60">
                                <then>
                                    <output expression="&quot;Karena anda sudah tua anda dapat diskon 30%&quot;" newline="True"/>
                                    <assign variable="Diskon" expression="0.30"/>
                                </then>
                                <else>
                                    <output expression="&quot;Mohon maaf anda tidak memenuhi syarat untuk mendapat diskon&quot;" newline="True"/>
                                    <assign variable="Diskon" expression="0.0"/>
                                </else>
                            </if>
                            <assign variable="HargaSetelahDiskon" expression="HargaDasar - (HargaDasar * Diskon)"/>
                            <assign variable="Total" expression="HargaSetelahDiskon * JumlahTiket"/>
                        </else>
                    </if>
                    <output expression="&quot;Jadi total yang harus anda bayar adalah : Rp &quot; &amp; Total" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
